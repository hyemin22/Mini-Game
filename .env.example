# 국립국어원 한국어기초사전 Open API 인증키
# 발급: https://krdict.korean.go.kr/kor/openApi/openApiRegister
KOREAN_DICT_API_KEY=발급받은_32자리_인증키

# Vercel에 배포한 프론트 주소. 여러 주소는 쉼표로 구분할 수 있습니다.
FRONTEND_URL=https://your-frontend.vercel.app

# 선택사항: 인물 DB 최근 등록 목록을 볼 개발자 전화번호
DEVELOPER_PHONE=

# 선택사항: Render 등에서는 플랫폼이 PORT를 주입합니다.
PORT=3000
